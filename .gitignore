# ============================================
# Project Celestia - .gitignore
# ============================================

# --- Archivos del sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor y IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.user
*.userprefs

# --- Dependencias y node_modules ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
pnpm-lock.yaml

# --- Archivos temporales ---
*.tmp
*.temp
*.cache
*.log
tmp/
temp/

# --- Base de datos local ---
*.sqlite
*.sqlite3
*.db

# --- Configuración de entorno ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Archivos de configuración específicos ---
config/local.php
config/global.php.local

# --- Archivos generados por el sistema ---
files/uploads/
files/temp/
files/cache/

# --- Reportes generados ---
reportes/generados/
*.pdf
*.xlsx
*.csv

# --- Librerías de terceros ---
fpdf181/
tcpdf/
vendor/

# --- Archivos comprimidos ---
*.zip
*.rar
*.tar.gz
*.7z

# --- Archivos de respaldo ---
*.bak
*.backup
*.old
*.orig

# --- Logs del sistema ---
logs/
*.log
error_log
access_log

# --- Archivos de documentación generados ---
docs/manuals/*.pdf
docs/media/*.gif
docs/media/*.mp4
docs/media/*.mov

# --- Archivos de código compilado ---
*.min.js
*.min.css

# --- Archivos de captura de pantalla ---
screenshots/
capturas/

# --- Archivos de testeo ---
tests/
coverage/
.nyc_output/

# --- Archivos de configuración de Git ---
.gitconfig
.gitattributes
.gitmodules

# --- Archivos de linting ---
.eslintcache
.stylelintcache
